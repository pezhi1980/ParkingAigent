# DK Parking Backend — Environment Variables
# Copy this file to .env for local development.
# On Render: set these in the Render dashboard → Environment tab.

# Supabase project URL (from Supabase dashboard → Settings → API)
SUPABASE_URL=https://qnvgtkxcdbirzoeceltt.supabase.co

# Supabase service role key — KEEP SECRET, never commit this value
# From Supabase dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# API key that mobile apps send in X-API-Key header
# Generate a random string: openssl rand -hex 32
MOBILE_API_KEY=your_mobile_api_key_here

# Comma-separated list of allowed CORS origins (leave blank to allow all)
ALLOWED_ORIGINS=

# Port (Render sets this automatically)
PORT=3000
