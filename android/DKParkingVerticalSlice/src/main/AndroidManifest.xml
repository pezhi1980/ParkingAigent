<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml — DK Parking Engine Android Vertical Slice -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission required for ARCore -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ARCore optional — required for core functionality -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="true" />

    <application
        android:allowBackup="false"
        android:label="DK Parking (Android Vertical Slice)"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- ARCore requirement declaration -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="required" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
